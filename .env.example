# Dokumentasi variabel; bukan konfigurasi runtime yang otomatis dimuat.
# Salin variabel ke aplikasi pemilik setelah integrasi diimplementasikan.
# Browser hanya boleh menerima konfigurasi publik.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
# SERVER ONLY: jangan beri prefix NEXT_PUBLIC_ pada rahasia.
DATABASE_URL=
AUTH_SECRET=
PAYMENT_WEBHOOK_SECRET=
EMAIL_API_KEY=
# HYPERDRIVE, MEDIA_BUCKET, JOBS_QUEUE adalah binding Workers,
# bukan kredensial string yang otomatis berasal dari file ini.