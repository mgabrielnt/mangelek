# Copy to apps/platform/.env.local. Never commit real secrets.
# Supabase project > Connect: use the PUBLIC publishable key, not service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Google OAuth Client ID and Secret belong in Supabase's Google provider settings.

# Billing: apply packages/db/migrations/20260920_billing.sql first.
# Secrets remain server-only. Start in sandbox; never use live payment data for tests.
BILLING_ENABLED=false
APP_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_ENVIRONMENT=sandbox
